{
  "name": "guitar-app",
  "private": true,
  "version": "0.7.1",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @guitar/web dev",
    "build": "pnpm --filter @guitar/web build",
    "preview": "pnpm --filter @guitar/web preview",
    "test": "pnpm --filter @guitar/core test",
    "check:styles": "node apps/web/scripts/check-styles.mjs",
    "check:pwa": "node apps/web/scripts/check-pwa.mjs",
    "check:a11y": "node apps/web/scripts/check-a11y.mjs",
    "check:all": "pnpm test && node apps/web/scripts/check-styles.mjs && node apps/web/scripts/check-pwa.mjs && node apps/web/scripts/check-a11y.mjs",
    "gen:icons": "node apps/web/scripts/gen-icons.mjs",
    "gen:levels": "pnpm --filter @guitar/core gen:levels",
    "demo": "pnpm --filter @guitar/core demo"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.67.2",
    "rollup": "4.67.2"
  }
}
